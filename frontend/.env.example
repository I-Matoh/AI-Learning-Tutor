# =============================================================================
# AI Learning Tutor - Frontend Environment Configuration
# =============================================================================
#
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Variables prefixed with VITE_ are PUBLIC and exposed to the browser
#
# Security Note:
# - VITE_ prefixed variables are client-safe (public keys, API endpoints)
# - Never put sensitive secrets (API keys for paid services) in frontend .env
# - For production, consider calling AI APIs from your backend server
#
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
# Found in: Supabase Dashboard > Settings > API > anon/public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API base URL
# Development: http://localhost:4000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:4000

# =============================================================================
# AI/GROQ CONFIGURATION
# =============================================================================
#
# SECURITY WARNING: The Groq API key is visible in the browser!
# 
# For production, it's recommended to call Groq from your backend server
# instead of directly from the frontend.
#
# Option 1: Frontend calls your backend, backend calls Groq (RECOMMENDED)
# Option 2: Frontend calls Groq directly (less secure, but simpler)
#

# Groq API key for AI content generation
# Get from: https://console.groq.com/keys
# SECURITY: This will be visible in browser source code!
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model for all AI tasks
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, etc.
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Specific models for different tasks (optional)
# Using smaller models for simpler tasks reduces cost
VITE_GROQ_MODEL_COURSE=llama-3.3-70b-versatile
VITE_GROQ_MODEL_LESSON=llama-3.1-8b-instant
VITE_GROQ_MODEL_QUIZ=llama-3.1-8b-instant

# Client-side rate limit for AI generations (per user, per day)
VITE_GROQ_DAILY_LIMIT=15

# =============================================================================
# SECURITY RECOMMENDATIONS
# =============================================================================
#
# For Production:
#
# 1. CALL AI APIs FROM BACKEND:
#    - Don't expose Groq API keys in frontend
#    - Frontend calls your /api/generate endpoint
#    - Backend adds the API key server-side
#
# 2. RATE LIMITING:
#    - Implement rate limiting in your backend
#    - Track usage per authenticated user
#    - Use server-side quotas, not client-side
#
# 3. CONTENT MODERATION:
#    - Validate AI-generated content on backend
#    - Implement content filtering
#    - Log all generation requests
#
# =============================================================================
