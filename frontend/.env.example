# =============================================================================
# AI Learning Tutor - Frontend Environment Configuration
# =============================================================================
#
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Variables prefixed with VITE_ are PUBLIC and exposed to the browser
#
# Security Note:
# - VITE_ prefixed variables are client-safe (public keys, API endpoints)
# - Never put sensitive secrets (API keys for paid services) in frontend .env
# - For production, consider calling AI APIs from your backend server
#
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
# Found in: Supabase Dashboard > Settings > API > anon/public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API base URL
# Development: http://localhost:4000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:4000

# =============================================================================
# GENERATION FLOW (SERVER-ONLY KEYS)
# =============================================================================
#
# Frontend never stores model-provider keys.
# The browser calls backend generation endpoints under VITE_API_BASE_URL.
# Backend holds provider keys and enforces auth, quota, and validation.
#
