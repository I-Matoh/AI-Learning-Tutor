# =============================================================================
# AI Learning Tutor - Server Environment Configuration
# =============================================================================
#
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
#
# Security Notes:
# - All variables in this file are SERVER-ONLY
# - Use strong, unique values for all secrets
# - In production, use a secrets manager (AWS Secrets, HashiCorp Vault, etc.)
#
# =============================================================================

# Server port (default: 4000)
PORT=4000

# Node environment - SET TO "production" IN PRODUCTION!
NODE_ENV=development

# Allowed CORS origins (comma-separated in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Application version (for health checks)
APP_VERSION=1.0.0

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase JWT secret for verifying user tokens
# Found in: Supabase Dashboard > Settings > API > JWT Secret
# SECURITY: This is a server-only secret. Never expose to clients!
# Must be at least 32 characters, use a cryptographically random string
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# Supabase service role key (for server-side privileged operations)
# Found in: Supabase Dashboard > Settings > API > Service Role Secret
# SECURITY: This key BYPASSES Row Level Security!
# SECURITY: Only use for admin operations, never expose to clients!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# AI/GROQ CONFIGURATION (Optional - for server-side AI calls)
# =============================================================================

# Groq API key for AI content generation (if calling from server)
# Get from: https://console.groq.com/keys
# SECURITY: This is a paid API key. Protect it like a password!
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SECURITY CHECKLIST FOR PRODUCTION
# =============================================================================
#
# Before deploying to production:
#
# 1. ENVIRONMENT:
#    [ ] Set NODE_ENV=production
#    [ ] Configure ALLOWED_ORIGINS for your domain(s)
#    [ ] Generate strong JWT secret (32+ random chars)
#
# 2. SUPABASE:
#    [ ] Enable Row Level Security on all tables
#    [ ] Configure appropriate RLS policies
#    [ ] Set up proper authentication providers
#
# 3. NETWORK:
#    [ ] Use HTTPS (configure reverse proxy or direct TLS)
#    [ ] Set up HSTS headers
#    [ ] Configure firewall rules
#
# 4. MONITORING:
#    [ ] Enable logging for security events
#    [ ] Set up rate limit monitoring
#    [ ] Configure alerts for suspicious activity
#
# =============================================================================
